# K3 and K6, the detector's two contracts — where a different fault detector goes in, and where
# a repair gets reported. Drawn together because K6 is the only thing that moves a latched case
# out of CONFIRMED, so neither is complete without the other.
#
# K3 TIER 1: anything that publishes a latched FaultStateChanged is a substitutable detector,
# and the payload invariant (a latched state carries a classification) is enforced on both sides
# of the wire. The honest qualification — the T-29 learned contender is scored inside the
# harness and has never been a second publisher, so Tier 1 here is argued from the dependency
# direction rather than demonstrated by a swap — is in seams.md § K3, along with the fact that
# K3 carries the verdict and not the model it was reached against (N1).
#
# K6 TIER 1: deliberately not under commands/, so any publisher may raise it without touching
# actuator authority. Published by the dashboard from the operator's page; consumed by the
# monitor alone.
#
# VERIFIED AGAINST: Topics.java:32, :36, :47; FaultStateChanged.java:14-20 with :31-34;
# ResidualComputed.java:10; ServiceReported.java:21 with :12-17 and :18-20;
# ZoneMonitor.java:722, :732; MonitorRuntime.java:109-113; ServiceResource.java:94.
direction: down

classes: {
  contract: { shape: hexagon; style.stroke-width: 2 }
  port: { shape: parallelogram; style.stroke-width: 2 }
  t1: { style.stroke: "#1e8449"; style.fill: "#eafaf1" }
  t2: { style.stroke: "#b9770e"; style.fill: "#fdf3e3" }
  t3: { style.stroke: "#c0392b"; style.fill: "#fdedec"; style.stroke-dash: 4 }
  box: { style.stroke-width: 2 }
  doc: { shape: document; style.fill: transparent }
}

mon: "fault-monitor\nraises events, never commands" { class: box }
alt: "any detector · any language\nKalman, learned, a vendor's own" { class: box }
k3: "K3 · diagnosis seam" { class: [contract; t1] }
c3: "faults/{zone} -> FaultStateChanged" { class: box }
cr: "residuals/{zone} -> ResidualComputed" { class: box }
sup: "supervisor\nacts only on a latched state" { class: box }
k6: "K6 · service report" { class: [contract; t1] }
md: "the Tier 1 caveat · evidence\nseams.md § K3, § K6" { class: doc }

mon -> k3
alt -> k3: "the same payload"
k3 -> c3
k3 -> cr
c3 -> sup
k6 -> mon: "the dashboard publishes it"
k3 -> md
k6 -> md
